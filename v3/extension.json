  "commands": [
    {
      "name": "search",
      "title": "Search for GIFs",
      "description": "Search for GIFs across multiple services\u2026",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "timeoutMs": 120000,
      "concurrency": "serialize",
      "refreshMs": 500
    },
    {
      "name": "favorites",
      "title": "Browse Favorite GIFs",
      "description": "Browse and search your favorite GIFs across all services",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "timeoutMs": 120000,
      "concurrency": "serialize",
      "refreshMs": 500
    },
